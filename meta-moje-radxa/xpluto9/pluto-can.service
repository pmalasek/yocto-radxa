[Unit]
Description=Pluto CAN Sender Service
# Spustit až po inicializaci sítě
After=network.target

[Service]
# Cesta k binárce
ExecStart=/opt/pluto/bin/pluto-can-sender
# Pracovní adresář (pokud binárka čte nějaké lokální soubory)
WorkingDirectory=/opt/pluto
# Automatický restart při pádu po 5 sekundách
Restart=always
RestartSec=5
# Uživatel, pod kterým to poběží (root je pro CAN často nutný)
User=root

[Install]
# Definice, že služba patří do běžného startu systému
WantedBy=multi-user.target
