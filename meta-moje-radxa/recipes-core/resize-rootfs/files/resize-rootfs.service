[Unit]
Description=Resize root filesystem to fill available disk space
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target systemd-remount-fs.service
ConditionPathExists=/usr/sbin/resize-rootfs.sh

[Service]
Type=oneshot
ExecStart=/usr/sbin/resize-rootfs.sh
RemainAfterExit=yes

[Install]
WantedBy=local-fs.target
